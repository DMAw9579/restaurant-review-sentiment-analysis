# Copy this file to ".env" and fill in your key to enable the AI features
# (review summarization, recommendations, chatbot). Get a key at
# https://console.anthropic.com/signup
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for AI features.
# Defaults to claude-haiku-4-5-20251001 (fast & inexpensive).
AI_MODEL=claude-haiku-4-5-20251001

# Without ANTHROPIC_API_KEY set, all three AI features still work using
# built-in rule-based fallbacks (see utils/aiService.js), so the app
# never breaks - it just won't use real AI-generated text until a key
# is added.
