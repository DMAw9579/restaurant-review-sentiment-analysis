<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin Dashboard</title>

  <!-- Google Font -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    :root{
      --primary:#27ae60;
      --primary-dark:#1f8a4d;
      --orange:#f39c12;
      --blue:#3498db;
      --red:#e74c3c;
      --white:#ffffff;
      --glass:rgba(255,255,255,0.12);
      --border:rgba(255,255,255,0.18);
      --text:#ecf0f1;
      --dark:#1e272e;
    }

    body{
      font-family:'Poppins', sans-serif;
      min-height:100vh;
      padding:40px 20px;

      background:
      linear-gradient(rgba(0,0,0,0.72), rgba(0,0,0,0.72)),
      url('https://images.unsplash.com/photo-1552566626-52f8b828add9?auto=format&fit=crop&w=1400&q=80');

      background-size:cover;
      background-position:center;
      background-attachment:fixed;
      color:var(--white);
    }

    /* ================= HEADER ================= */

    .top-header{
      max-width:1300px;
      margin:auto;
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-bottom:30px;
      flex-wrap:wrap;
      gap:20px;
    }

    .dashboard-title h1{
      font-size:38px;
      font-weight:700;
      margin-bottom:5px;
    }

    .dashboard-title p{
      color:#dfe6e9;
      font-size:15px;
    }

    .logout-btn{
      text-decoration:none;
      background:rgba(231,76,60,0.15);
      color:#fff;
      border:1px solid rgba(255,255,255,0.15);
      padding:12px 22px;
      border-radius:14px;
      font-weight:600;
      transition:0.3s;
      backdrop-filter:blur(10px);
    }

    .logout-btn:hover{
      background:var(--red);
      transform:translateY(-2px);
    }

    /* ================= MAIN CONTAINER ================= */

    .container{
      max-width:1300px;
      margin:auto;
      background:var(--glass);
      border:1px solid var(--border);
      border-radius:25px;
      padding:35px;
      backdrop-filter:blur(14px);
      -webkit-backdrop-filter:blur(14px);
      box-shadow:0 10px 40px rgba(0,0,0,0.35);
      animation:fadeIn 0.7s ease;
    }

    @keyframes fadeIn{
      from{
        opacity:0;
        transform:translateY(20px);
      }
      to{
        opacity:1;
        transform:translateY(0);
      }
    }

    /* ================= ACTIONS ================= */

    .top-actions{
      display:flex;
      justify-content:space-between;
      align-items:center;
      flex-wrap:wrap;
      gap:20px;
      margin-bottom:30px;
    }

    .action-buttons{
      display:flex;
      gap:15px;
      flex-wrap:wrap;
    }

    .btn{
      padding:13px 22px;
      border:none;
      border-radius:14px;
      text-decoration:none;
      color:white;
      font-weight:600;
      font-size:15px;
      transition:0.3s;
      display:inline-flex;
      align-items:center;
      gap:8px;
      cursor:pointer;
    }

    .btn:hover{
      transform:translateY(-3px);
      box-shadow:0 8px 18px rgba(0,0,0,0.25);
    }

    .btn-add{
      background:linear-gradient(135deg,#27ae60,#2ecc71);
    }

    .btn-review{
      background:linear-gradient(135deg,#f39c12,#f1c40f);
    }

    /* ================= SEARCH ================= */

    .search-box{
      position:relative;
    }

    .search-box input{
      width:320px;
      max-width:100%;
      padding:14px 18px;
      border:none;
      border-radius:14px;
      outline:none;
      background:rgba(255,255,255,0.92);
      font-size:15px;
      color:#333;
      transition:0.3s;
    }

    .search-box input:focus{
      background:#fff;
      box-shadow:0 0 0 4px rgba(39,174,96,0.25);
    }

    /* ================= TABLE ================= */

    .table-title{
      margin-bottom:18px;
      font-size:24px;
      font-weight:600;
    }

    .table-wrapper{
      overflow-x:auto;
      border-radius:18px;
    }

    table{
      width:100%;
      border-collapse:collapse;
      overflow:hidden;
      border-radius:18px;
    }

    thead{
      background:rgba(255,255,255,0.12);
    }

    th{
      padding:18px;
      text-align:left;
      font-size:14px;
      text-transform:uppercase;
      color:#fff;
      letter-spacing:0.5px;
    }

    td{
      padding:18px;
      color:#f1f1f1;
      border-top:1px solid rgba(255,255,255,0.08);
    }

    tbody tr{
      transition:0.3s;
    }

    tbody tr:hover{
      background:rgba(255,255,255,0.08);
    }

    .actions{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
    }

    .btn-edit{
      background:linear-gradient(135deg,#3498db,#5dade2);
    }

    .btn-delete{
      background:linear-gradient(135deg,#e74c3c,#ff6b6b);
    }

    /* ================= EMPTY ================= */

    .empty{
      text-align:center;
      padding:40px;
      color:#dcdde1;
      font-size:18px;
    }

    /* ================= FOOTER ================= */

    footer{
      text-align:center;
      margin-top:35px;
      color:#dfe6e9;
      font-size:14px;
    }

    /* ================= RESPONSIVE ================= */

    @media(max-width:768px){

      .top-header{
        flex-direction:column;
        align-items:flex-start;
      }

      .dashboard-title h1{
        font-size:30px;
      }

      .top-actions{
        flex-direction:column;
        align-items:stretch;
      }

      .action-buttons{
        width:100%;
      }

      .btn{
        justify-content:center;
        width:100%;
      }

      .search-box input{
        width:100%;
      }

      th, td{
        font-size:13px;
        padding:14px;
      }

    }

  </style>
</head>

<body>

  <!-- HEADER -->
  <div class="top-header">

    <div class="dashboard-title">
      <h1>🍽️ Admin Dashboard</h1>
      <p>Manage restaurants, reviews and analytics easily.</p>
    </div>

    <a href="/admin/logout" class="logout-btn">
      🚪 Logout
    </a>

  </div>

  <!-- MAIN -->
  <div class="container">

    <!-- ACTIONS -->
    <div class="top-actions">

      <div class="action-buttons">

        <a href="/restaurant/add" class="btn btn-add">
          ➕ Add Restaurant
        </a>

        <a href="/add-review" class="btn btn-review">
          ⭐ Add Review
        </a>

      </div>

      <div class="search-box">

        <input 
          type="text"
          id="searchBar"
          placeholder="🔍 Search restaurants..."
          onkeyup="filterTable()"
        >

      </div>

    </div>

    <!-- TABLE -->
    <h2 class="table-title">📋 Restaurant List</h2>

    <% if (restaurants && restaurants.length > 0) { %>

      <div class="table-wrapper">

        <table id="restaurantTable">

          <thead>
            <tr>
              <th>Restaurant</th>
              <th>City</th>
              <th>Address</th>
              <th style="width:220px;">Actions</th>
            </tr>
          </thead>

          <tbody>

            <% restaurants.forEach(r => { %>

              <tr>

                <td><%= r.restaurant_name %></td>

                <td><%= r.city %></td>

                <td><%= r.address %></td>

                <td>

                  <div class="actions">

                    <a href="/restaurant/edit/<%= r._id %>" class="btn btn-edit">
                      ✏️ Edit
                    </a>

                    <button 
                      class="btn btn-delete"
                      onclick="deleteRestaurant('<%= r._id %>')"
                    >
                      🗑️ Delete
                    </button>

                  </div>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    <% } else { %>

      <p class="empty">
        No restaurants found in the database.
      </p>

    <% } %>

  </div>

  <footer>
    © 2025 Restaurant Review System | Made with ❤️ by Deepika
  </footer>

  <script>

    // DELETE RESTAURANT
    async function deleteRestaurant(id){

      if(confirm("Are you sure you want to delete this restaurant?")){

        const res = await fetch(`/restaurant/delete/${id}`, {
          method:'DELETE'
        });

        if(res.ok){

          alert("✅ Restaurant deleted successfully!");

          window.location.reload();

        }else{

          alert("❌ Failed to delete restaurant.");

        }

      }

    }

    // SEARCH FUNCTION
    function filterTable(){

      const query = document
      .getElementById("searchBar")
      .value
      .toLowerCase();

      const rows = document.querySelectorAll("#restaurantTable tbody tr");

      rows.forEach(row => {

        const text = row.textContent.toLowerCase();

        row.style.display = text.includes(query) ? "" : "none";

      });

    }

  </script>

</body>
</html>