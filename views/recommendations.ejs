<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>AI Recommendations | TasteTales</title>

  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>

    *{ margin:0; padding:0; box-sizing:border-box; }

    :root{
      --primary:#27ae60;
      --white:#ffffff;
      --glass:rgba(255,255,255,0.12);
      --border:rgba(255,255,255,0.18);
    }

    body{
      font-family:'Poppins', sans-serif;
      min-height:100vh;
      padding:40px 20px 60px;
      color:var(--white);

      background:
        linear-gradient(rgba(0,0,0,0.72), rgba(0,0,0,0.75)),
        url('https://images.unsplash.com/photo-1552566626-52f8b828add9?auto=format&fit=crop&w=1400&q=80');

      background-size:cover;
      background-position:center;
      background-attachment:fixed;
    }

    .wrapper{ max-width:1100px; margin:auto; }

    .top-header{
      display:flex;
      justify-content:space-between;
      align-items:center;
      flex-wrap:wrap;
      gap:20px;
      margin-bottom:35px;
    }

    .top-header h1{ font-size:32px; font-weight:700; margin-bottom:6px; }
    .top-header p{ color:#d1d5db; font-size:15px; }

    .btn{
      text-decoration:none;
      color:white;
      padding:12px 20px;
      border-radius:14px;
      font-weight:600;
      font-size:14px;
      transition:0.3s;
      display:inline-flex;
      align-items:center;
      gap:6px;
      border:none;
      cursor:pointer;
      font-family:inherit;
    }

    .btn-outline{
      background:rgba(255,255,255,0.1);
      border:1px solid rgba(255,255,255,0.25);
    }

    .btn-outline:hover{ background:rgba(255,255,255,0.18); }

    .btn-primary{
      background:linear-gradient(135deg,#27ae60,#2ecc71);
      box-shadow:0 5px 15px rgba(39,174,96,0.3);
    }

    .btn-primary:hover{ transform:translateY(-2px); }

    /* FORM */
    .form-card{
      background:var(--glass);
      border:1px solid var(--border);
      backdrop-filter:blur(12px);
      padding:30px;
      border-radius:22px;
      margin-bottom:40px;
    }

    .form-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
      gap:18px;
      margin-bottom:22px;
    }

    .form-field label{
      display:block;
      font-size:13px;
      color:#cbd5e1;
      margin-bottom:8px;
      text-transform:uppercase;
      letter-spacing:0.5px;
    }

    .form-field select,
    .form-field input{
      width:100%;
      padding:12px 14px;
      border-radius:12px;
      border:none;
      outline:none;
      background:rgba(255,255,255,0.92);
      font-size:14px;
      color:#333;
      font-family:inherit;
    }

    /* RESULTS */
    .results-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
      gap:22px;
    }

    .rec-card{
      background:var(--glass);
      border:1px solid var(--border);
      backdrop-filter:blur(12px);
      padding:24px;
      border-radius:20px;
      transition:0.3s;
    }

    .rec-card:hover{ transform:translateY(-5px); background:rgba(255,255,255,0.18); }

    .rec-card h3{ font-size:19px; margin-bottom:6px; }

    .rec-card .meta{ color:#d1d5db; font-size:13px; margin-bottom:12px; }

    .rec-card .rating-badge{
      background:rgba(241,196,15,0.18);
      color:#f1c40f;
      padding:5px 10px;
      border-radius:10px;
      font-weight:600;
      font-size:13px;
    }

    .rec-card .reason{
      margin-top:14px;
      font-size:13.5px;
      color:#e5e7eb;
      line-height:1.6;
      border-top:1px solid rgba(255,255,255,0.1);
      padding-top:12px;
    }

    .empty, .loading{
      text-align:center;
      padding:35px;
      color:#dcdde1;
      background:var(--glass);
      border-radius:18px;
      border:1px solid var(--border);
    }

  </style>
</head>

<body>

  <div class="wrapper">

    <div class="top-header">
      <div>
        <h1>🎯 AI Restaurant Recommendations</h1>
        <p>Tell us what you're in the mood for and let AI pick the best matches from real reviews.</p>
      </div>
      <a href="/" class="btn btn-outline">← Back to Home</a>
    </div>

    <div class="form-card">

      <form id="recommendForm">

        <div class="form-grid">

          <div class="form-field">
            <label for="cuisine">Preferred Cuisine</label>
            <select id="cuisine" name="cuisine">
              <option value="">Any cuisine</option>
              <% cuisines.forEach(c => { %>
                <option value="<%= c %>"><%= c %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-field">
            <label for="city">Location</label>
            <select id="city" name="city">
              <option value="">Any city</option>
              <% cities.forEach(c => { %>
                <option value="<%= c %>"><%= c %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-field">
            <label for="priority">What matters most?</label>
            <select id="priority" name="priority">
              <option value="rating">Highest rated overall</option>
              <option value="family">Family-friendly dining</option>
              <option value="value">Best value for money</option>
              <option value="sentiment">Most positive customer sentiment</option>
            </select>
          </div>

        </div>

        <button type="submit" class="btn btn-primary">✨ Get AI Recommendations</button>

      </form>

    </div>

    <div id="resultsContainer">
      <div class="empty">Fill in your preferences above and click "Get AI Recommendations".</div>
    </div>

  </div>

  <script>
    const form = document.getElementById('recommendForm');
    const resultsContainer = document.getElementById('resultsContainer');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      resultsContainer.innerHTML = '<div class="loading">🤖 Finding the best matches for you...</div>';

      const payload = {
        cuisine: document.getElementById('cuisine').value,
        city: document.getElementById('city').value,
        priority: document.getElementById('priority').value
      };

      try {
        const res = await fetch('/api/ai/recommend', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        renderResults(data.recommendations || []);
      } catch (err) {
        resultsContainer.innerHTML = '<div class="empty">Something went wrong getting recommendations. Please try again.</div>';
      }
    });

    function renderResults(recommendations) {
      if (!recommendations.length) {
        resultsContainer.innerHTML = '<div class="empty">No matching restaurants found. Try broadening your preferences.</div>';
        return;
      }

      resultsContainer.innerHTML = '<div class="results-grid"></div>';
      const grid = resultsContainer.querySelector('.results-grid');

      recommendations.forEach((r) => {
        const card = document.createElement('div');
        card.className = 'rec-card';
        card.innerHTML = `
          <h3>${escapeHtml(r.restaurant_name)}</h3>
          <div class="meta">📍 ${escapeHtml(r.city || 'Unknown')} • ${escapeHtml(r.cuisine || 'Multi-cuisine')}</div>
          <span class="rating-badge">⭐ ${r.avgRating ?? 'N/A'} (${r.reviewCount} reviews)</span>
          <div class="reason">${escapeHtml(r.reason || '')}</div>
        `;
        grid.appendChild(card);
      });
    }

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }
  </script>

  <%- include('partials/chatbot') %>

</body>
</html>
