<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>My Dashboard | TasteTales</title>

  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    :root{
      --primary:#27ae60;
      --primary-dark:#1f8a4d;
      --orange:#f39c12;
      --blue:#3498db;
      --red:#e74c3c;
      --white:#ffffff;
      --glass:rgba(255,255,255,0.12);
      --border:rgba(255,255,255,0.18);
    }

    body{
      font-family:'Poppins', sans-serif;
      min-height:100vh;
      padding:40px 20px 60px;
      color:var(--white);

      background:
        linear-gradient(rgba(0,0,0,0.72), rgba(0,0,0,0.75)),
        url('https://images.unsplash.com/photo-1552566626-52f8b828add9?auto=format&fit=crop&w=1400&q=80');

      background-size:cover;
      background-position:center;
      background-attachment:fixed;
    }

    .wrapper{
      max-width:1300px;
      margin:auto;
    }

    /* HEADER */
    .top-header{
      display:flex;
      justify-content:space-between;
      align-items:center;
      flex-wrap:wrap;
      gap:20px;
      margin-bottom:35px;
    }

    .welcome h1{
      font-size:32px;
      font-weight:700;
      margin-bottom:6px;
    }

    .welcome p{
      color:#d1d5db;
      font-size:15px;
    }

    .header-actions{
      display:flex;
      gap:12px;
      flex-wrap:wrap;
    }

    .btn{
      text-decoration:none;
      color:white;
      padding:12px 20px;
      border-radius:14px;
      font-weight:600;
      font-size:14px;
      transition:0.3s;
      display:inline-flex;
      align-items:center;
      gap:6px;
      border:none;
      cursor:pointer;
      font-family:inherit;
    }

    .btn-primary{
      background:linear-gradient(135deg,#27ae60,#2ecc71);
      box-shadow:0 5px 15px rgba(39,174,96,0.3);
    }

    .btn-primary:hover{ transform:translateY(-2px); }

    .btn-outline{
      background:rgba(255,255,255,0.1);
      border:1px solid rgba(255,255,255,0.25);
    }

    .btn-outline:hover{ background:rgba(255,255,255,0.18); }

    .btn-logout{
      background:linear-gradient(135deg,#e74c3c,#ff6b6b);
    }

    .btn-logout:hover{ transform:translateY(-2px); }

    /* STAT CARDS */
    .stats{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
      gap:20px;
      margin-bottom:45px;
    }

    .stat-card{
      background:var(--glass);
      border:1px solid var(--border);
      backdrop-filter:blur(12px);
      padding:22px;
      border-radius:18px;
      text-align:center;
    }

    .stat-card .num{
      font-size:30px;
      font-weight:700;
      margin-bottom:4px;
    }

    .stat-card .label{
      font-size:13px;
      color:#d1d5db;
      text-transform:uppercase;
      letter-spacing:0.5px;
    }

    .stat-positive .num{ color:#2ecc71; }
    .stat-neutral .num{ color:#f1c40f; }
    .stat-negative .num{ color:#e74c3c; }

    /* SECTION */
    .section{
      margin-bottom:50px;
    }

    .section-header{
      display:flex;
      justify-content:space-between;
      align-items:center;
      flex-wrap:wrap;
      gap:15px;
      margin-bottom:22px;
    }

    .section-header h2{
      font-size:24px;
      font-weight:600;
    }

    .search-box input{
      width:280px;
      max-width:100%;
      padding:13px 16px;
      border:none;
      border-radius:14px;
      outline:none;
      background:rgba(255,255,255,0.92);
      font-size:14px;
      color:#333;
      font-family:inherit;
      transition:0.3s;
    }

    .search-box input:focus{
      background:#fff;
      box-shadow:0 0 0 4px rgba(39,174,96,0.25);
    }

    /* RESTAURANT GRID */
    .restaurant-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
      gap:22px;
    }

    .restaurant-card{
      background:var(--glass);
      border:1px solid var(--border);
      backdrop-filter:blur(12px);
      padding:24px;
      border-radius:20px;
      transition:0.3s;
    }

    .restaurant-card:hover{
      transform:translateY(-5px);
      background:rgba(255,255,255,0.18);
    }

    .restaurant-card h3{
      font-size:19px;
      margin-bottom:6px;
    }

    .restaurant-card .city{
      color:#d1d5db;
      font-size:13px;
      margin-bottom:14px;
    }

    .restaurant-meta{
      display:flex;
      justify-content:space-between;
      align-items:center;
      font-size:14px;
    }

    .rating-badge{
      background:rgba(241,196,15,0.18);
      color:#f1c40f;
      padding:6px 12px;
      border-radius:10px;
      font-weight:600;
    }

    .review-count{
      color:#cbd5e1;
    }

    .empty{
      text-align:center;
      padding:35px;
      color:#dcdde1;
      background:var(--glass);
      border-radius:18px;
      border:1px solid var(--border);
    }

    /* MY REVIEWS */
    .my-review-card{
      background:rgba(255,255,255,0.08);
      border:1px solid rgba(255,255,255,0.1);
      padding:22px;
      border-radius:18px;
      margin-bottom:16px;
    }

    .my-review-top{
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      flex-wrap:wrap;
      gap:10px;
      margin-bottom:10px;
    }

    .my-review-top h4{
      font-size:17px;
    }

    .badge{
      padding:5px 12px;
      border-radius:10px;
      font-size:12px;
      font-weight:600;
    }

    .badge-Positive{ background:rgba(46,204,113,0.2); color:#2ecc71; }
    .badge-Neutral{ background:rgba(241,196,15,0.2); color:#f1c40f; }
    .badge-Negative{ background:rgba(231,76,60,0.2); color:#e74c3c; }

    .my-review-text{
      color:#e5e7eb;
      font-size:14px;
      line-height:1.7;
      margin-bottom:14px;
    }

    .my-review-bottom{
      display:flex;
      justify-content:space-between;
      align-items:center;
      flex-wrap:wrap;
      gap:10px;
      font-size:13px;
      color:#cbd5e1;
    }

    .delete-btn{
      background:linear-gradient(135deg,#e74c3c,#ff6b6b);
      border:none;
      color:white;
      padding:8px 16px;
      border-radius:10px;
      cursor:pointer;
      font-size:13px;
      font-weight:600;
      font-family:inherit;
      transition:0.3s;
    }

    .delete-btn:hover{ transform:translateY(-2px); }

    @media(max-width:600px){
      .welcome h1{ font-size:26px; }
      .search-box input{ width:100%; }
    }

  </style>
</head>

<body>

  <div class="wrapper">

    <!-- HEADER -->
    <div class="top-header">

      <div class="welcome">
        <h1>Welcome, <%= user.name %> 👋</h1>
        <p>Here's what's happening with your restaurant reviews.</p>
      </div>

      <div class="header-actions">
        <a href="/add-review" class="btn btn-primary">⭐ Add Review</a>
        <a href="/profile" class="btn btn-outline">👤 Profile</a>
        <a href="/logout" class="btn btn-logout">🚪 Logout</a>
      </div>

    </div>

    <!-- SENTIMENT STATS -->
    <div class="stats">

      <div class="stat-card stat-positive">
        <div class="num"><%= sentimentSummary.Positive %></div>
        <div class="label">Positive Reviews</div>
      </div>

      <div class="stat-card stat-neutral">
        <div class="num"><%= sentimentSummary.Neutral %></div>
        <div class="label">Neutral Reviews</div>
      </div>

      <div class="stat-card stat-negative">
        <div class="num"><%= sentimentSummary.Negative %></div>
        <div class="label">Negative Reviews</div>
      </div>

      <div class="stat-card">
        <div class="num"><%= myReviews.length %></div>
        <div class="label">My Reviews</div>
      </div>

    </div>

    <!-- RESTAURANTS -->
    <div class="section">

      <div class="section-header">
        <h2>🍽️ Restaurants</h2>

        <div class="search-box">
          <input
            type="text"
            id="searchInput"
            placeholder="🔍 Search restaurants or cities..."
            onkeyup="filterRestaurants()"
          >
        </div>
      </div>

      <% if (restaurants && restaurants.length > 0) { %>

        <div class="restaurant-grid" id="restaurantGrid">

          <% restaurants.forEach(r => { %>

            <div class="restaurant-card" data-name="<%= r.restaurant_name.toLowerCase() %>" data-city="<%= (r.city || '').toLowerCase() %>">
              <h3><%= r.restaurant_name %></h3>
              <div class="city">📍 <%= r.city %></div>

              <div class="restaurant-meta">
                <span class="rating-badge">⭐ <%= r.avgRating %></span>
                <span class="review-count"><%= r.reviewCount %> review<%= r.reviewCount === 1 ? '' : 's' %></span>
              </div>

              <button
                type="button"
                class="ai-summary-btn"
                onclick="showAiSummary('<%= r.restaurant_name.replace(/'/g, "\\'") %>')"
                style="margin-top:12px;width:100%;padding:8px;border:none;border-radius:8px;background:linear-gradient(135deg,#27ae60,#2ecc71);color:white;font-weight:600;cursor:pointer;"
              >
                🤖 AI Summary
              </button>
            </div>

          <% }); %>

        </div>

        <p id="noResults" class="empty" style="display:none; margin-top:20px;">No restaurants match your search.</p>

      <% } else { %>

        <div class="empty">No restaurants added yet.</div>

      <% } %>

    </div>

    <!-- SENTIMENT / CHART LINKS -->
    <div class="section">
      <div class="section-header">
        <h2>📊 Analytics</h2>
      </div>

      <div class="restaurant-grid">
        <a href="/charts" class="restaurant-card" style="text-decoration:none;color:white;">
          <h3>📈 Average Ratings</h3>
          <div class="city">See rating & review count per restaurant</div>
        </a>

        <a href="/sentiment-charts" class="restaurant-card" style="text-decoration:none;color:white;">
          <h3>😊 Sentiment Breakdown</h3>
          <div class="city">Positive / Neutral / Negative per restaurant</div>
        </a>

        <a href="/views-rating" class="restaurant-card" style="text-decoration:none;color:white;">
          <h3>📅 Ratings Over Time</h3>
          <div class="city">Track rating trends over time</div>
        </a>

        <a href="/recommendations" class="restaurant-card" style="text-decoration:none;color:white;">
          <h3>🤖 AI Recommendations</h3>
          <div class="city">Get personalized restaurant picks</div>
        </a>
      </div>
    </div>

    <!-- MY REVIEWS -->
    <div class="section">

      <div class="section-header">
        <h2>📝 My Submitted Reviews</h2>
      </div>

      <% if (myReviews && myReviews.length > 0) { %>

        <% myReviews.forEach(rev => { %>

          <div class="my-review-card">

            <div class="my-review-top">
              <h4><%= rev.restaurant_name %><% if (rev.city) { %> — <%= rev.city %><% } %></h4>
              <span class="badge badge-<%= rev.review_sentiment || 'Neutral' %>"><%= rev.review_sentiment || 'Neutral' %></span>
            </div>

            <div class="my-review-text">
              "<%= rev.review_text %>"
            </div>

            <div class="my-review-bottom">
              <span>⭐ <%= rev.review_rating %>/5 &nbsp;•&nbsp; <%= rev.review_date %></span>

              <form action="/my-reviews/delete/<%= rev._id %>" method="POST" onsubmit="return confirm('Delete this review?');">
                <button type="submit" class="delete-btn">🗑️ Delete</button>
              </form>
            </div>

          </div>

        <% }); %>

      <% } else { %>

        <div class="empty">You haven't submitted any reviews yet. <a href="/add-review" style="color:#2ecc71;">Write your first one →</a></div>

      <% } %>

    </div>

  </div>

  <script>
    function filterRestaurants(){
      const query = document.getElementById('searchInput').value.toLowerCase().trim();
      const cards = document.querySelectorAll('#restaurantGrid .restaurant-card');
      let visibleCount = 0;

      cards.forEach(card => {
        const name = card.getAttribute('data-name');
        const city = card.getAttribute('data-city');
        const matches = name.includes(query) || city.includes(query);
        card.style.display = matches ? '' : 'none';
        if (matches) visibleCount++;
      });

      const noResults = document.getElementById('noResults');
      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    // ---- AI Review Summary modal ----
    async function showAiSummary(restaurantName) {
      let modal = document.getElementById('aiSummaryModal');
      if (!modal) {
        modal = document.createElement('div');
        modal.id = 'aiSummaryModal';
        modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.6);display:flex;align-items:center;justify-content:center;z-index:3000;';
        modal.innerHTML =
          '<div style="background:#111827;border:1px solid rgba(255,255,255,0.15);border-radius:16px;max-width:480px;width:90%;padding:24px;color:white;">' +
            '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">' +
              '<h3 id="aiSummaryTitle" style="margin:0;">🤖 AI Summary</h3>' +
              '<button onclick="document.getElementById(\'aiSummaryModal\').remove()" style="background:none;border:none;color:white;font-size:18px;cursor:pointer;">✕</button>' +
            '</div>' +
            '<div id="aiSummaryBody">Loading summary...</div>' +
          '</div>';
        document.body.appendChild(modal);
      }
      document.getElementById('aiSummaryTitle').textContent = '🤖 ' + restaurantName;
      document.getElementById('aiSummaryBody').textContent = 'Loading summary...';

      try {
        const res = await fetch('/api/ai/summary', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ restaurant_name: restaurantName })
        });
        const data = await res.json();
        document.getElementById('aiSummaryBody').textContent =
          data.summary || 'No summary available for this restaurant yet.';
      } catch (err) {
        document.getElementById('aiSummaryBody').textContent =
          'Something went wrong generating the summary. Please try again.';
      }
    }
  </script>

  <%- include('partials/chatbot') %>

</body>
</html>
